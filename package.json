{
  "name": "bullimia",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "python -m uvicorn server:app --app-dir backend --reload --port 8000",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:backend": "python -m pytest backend/tests -v",
    "test:frontend": "vitest run",
    "test": "npm run test:backend && npm run test:frontend",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-svelte": "^0.460.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.4.49",
    "svelte": "^5.0.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
